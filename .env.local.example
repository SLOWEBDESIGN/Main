# ── Server-only secrets (forms + booking backend) ────────────────────────────
# Set these in .env.local for dev and in Netlify > Site settings > Environment
# variables for production. NEVER commit real values or put them in netlify.toml.

# Supabase (service role key: Supabase dashboard > Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) — sender must be on a verified domain in production
RESEND_API_KEY=re_your_api_key
BOOKING_FROM_EMAIL=SLO Web Design <bookings@slowebdesign.com>
OWNER_EMAIL=contact@slowebdesign.com

# /admin login password + session cookie signing secret (32+ random bytes hex)
ADMIN_PASSWORD=choose-a-long-random-password
ADMIN_SESSION_SECRET=openssl-rand-hex-32-output

# Optional: static video-call link included in booking emails and calendar invites
# BOOKING_MEETING_URL=https://meet.google.com/your-room
